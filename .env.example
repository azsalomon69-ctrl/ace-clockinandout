PORT=3000
NODE_ENV=development
FRONTEND_ORIGIN=http://localhost:5500
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
# Use a Supabase secret key (sb_secret_...) or legacy service_role key. Never put this in Vercel/browser variables.
SUPABASE_SECRET_KEY=sb_secret_REPLACE_ME
# Safe to return to the browser; required by Supabase Auth alongside RLS.
SUPABASE_PUBLISHABLE_KEY=sb_publishable_REPLACE_ME
INITIAL_ADMIN_EMAIL=ace@admin.com
INITIAL_ADMIN_PASSWORD=CHANGE_THIS_TO_A_LONG_UNIQUE_PASSWORD
INVITE_REDIRECT_URL=http://localhost:5500/login.html
# Optional comma-separated company domains permitted to request access.
# Leave blank when staff use personal Google accounts; server-side request limits
# still protect the approval endpoint.
ALLOWED_EMAIL_DOMAINS=
