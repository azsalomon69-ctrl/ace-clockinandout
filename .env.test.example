# Required staging-only configuration. Never use production accounts,
# passwords, API URLs, or Supabase projects here. Copy this file to .env.test
# in the repository root (next to package.json), then fill in dedicated staging
# accounts. npm run test:security:integration loads .env.test automatically.
# .env.test is explicitly ignored and must never be committed.
ACE_TEST_API_URL=https://YOUR-STAGING-API.example.com
ACE_TEST_SUPABASE_URL=https://YOUR-STAGING-PROJECT.supabase.co
ACE_TEST_SUPABASE_PUBLISHABLE_KEY=sb_publishable_REPLACE_ME
ACE_TEST_ADMIN_EMAIL=staging-admin@example.test
ACE_TEST_ADMIN_PASSWORD=REPLACE_ME
ACE_TEST_USER_EMAIL=staging-user@example.test
ACE_TEST_USER_PASSWORD=REPLACE_ME

# Optional but recommended: a real sign-in account whose ACE profile status
# is PENDING, DENIED, or otherwise not ACTIVE. It is checked against a normal
# protected route and must receive 403.
ACE_TEST_INACTIVE_USER_EMAIL=
ACE_TEST_INACTIVE_USER_PASSWORD=

# Optional: exercises the special head-admin chat-log endpoint.
ACE_TEST_HEAD_ADMIN_EMAIL=
ACE_TEST_HEAD_ADMIN_PASSWORD=

# Optional, destructive staging-only checks. Do not enable against production.
# The target must be an isolated staging employee. These values are never logged.
ACE_TEST_RUN_MUTATIONS=false
ACE_TEST_USER_ID=
ACE_TEST_PROJECT_ID=
ACE_TEST_TIME_ENTRY_ID=
ACE_TEST_ACCESS_REQUEST_ID=
ACE_TEST_REPORT_ID=
ACE_TEST_INVITATION_ID=
